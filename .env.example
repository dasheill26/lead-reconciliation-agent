# Optional. If set, the agent makes real Anthropic API calls for ambiguous
# reconciliation decisions and computes real cost from actual token usage.
# If not set, the agent runs in simulated mode: same logic and decision
# paths, but the LLM call is a deterministic stand-in and the cost report
# is clearly labeled as an estimate rather than a real bill.
ANTHROPIC_API_KEY=

# Optional. Deal value (GBP) above which a CRM-ahead-of-evidence conflict
# is considered worth an LLM read. Below this, resolved by rule instead.
# Default: 10000
LLM_ESCALATION_THRESHOLD_GBP=10000

# Optional. Scrape records older than this many days are excluded from
# lead enrichment rather than trusted. Default: 7
STALE_SCRAPE_THRESHOLD_DAYS=7
